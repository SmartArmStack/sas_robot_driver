<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sas_robot_driver</name>
  <version>0.0.0</version>
  <description>The sas_conversions package for ROS2</description>
  <maintainer email="murilomarinho@ieee.org">Murilo M. Marinho</maintainer>
  <license>LGPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>eigen</depend>
  <depend>sas_common</depend>
  <depend>sas_core</depend>
  <depend>sas_conversions</depend>
  <depend>sas_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- dqrobotics (C++ libdqrobotics and the `dqrobotics` Python bindings) has
       no rosdep key; it comes from the DQ Robotics PPA and PyPI (see
       https://github.com/marinholab/docker_recipes). -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
